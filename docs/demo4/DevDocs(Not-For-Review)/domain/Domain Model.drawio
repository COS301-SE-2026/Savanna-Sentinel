        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class Severity {\n        &lt;&lt;enumeration&gt;&gt;\n        None\n        Low\n        Medium\n        High\n        Urgent\n    }\n\n    class SyncStatus {\n        &lt;&lt;enumeration&gt;&gt;\n        Syncing\n        OutOfSync\n        InSync\n    }\n\n    class ReportType {\n        &lt;&lt;enumeration&gt;&gt;\n        New\n        InProgress\n        Updated\n        Resolved\n    }\n\n    class Roles {\n        &lt;&lt;enumeration&gt;&gt;\n        Admin\n        Ranger\n        Analyst\n        Community Liaison\n    }\n\n    class AuditLog {\n        +UUID id\n        +String action\n        +String target_type\n        +String target_id\n        +JSONB details\n        +DateTime created_at\n    }\n\n    class User {\n        +UUID id\n        +String username\n        +String email\n        +String first_name\n        +String last_name\n        +Roles role\n        +Boolean is_active\n        +DateTime created_at\n    }\n\n    class FieldReport {\n        +UUID id\n        +ReportType report_type\n        +String description\n        +Geography~Point~ location\n        +DateTime occurred_at\n        +SyncStatus sync_status\n        +DateTime created_at\n        +DateTime updated_at\n        +DateTime deleted_at\n    }\n\n    class TipOff {\n        +UUID id\n        +ReportType report_type\n        +String description\n        +DateTime occurred_at\n        +Geography~Point~ location\n    }\n\n    class UploadWizard {\n        &lt;&lt;service&gt;&gt;\n    }\n\n    class GeospatialEvent {\n        &lt;&lt;abstract&gt;&gt;\n        +UUID id\n        +DateTime occurred_at\n        +Geography~Point~ location\n    }\n\n    class Incident {\n        +String incident_type\n        +String description\n        +Severity severity\n    }\n\n    class Sighting {\n        +String species\n        +Integer count\n    }\n\n    class PatrolTrack {\n        +Geography~LineString~ route_line\n        +Float distance_covered\n    }\n\n    class Photo {\n        +UUID id\n        +String image_url\n        +DateTime uploaded_at\n    }\n\n    class RiskEngine {\n        &lt;&lt;service&gt;&gt;\n    }\n\n    class PatrolPlanner {\n        &lt;&lt;service&gt;&gt;\n    }\n\n    class PatrolRoute {\n        +UUID id\n        +UUID request_id\n        +Geography~Point~ start_point\n        +Float max_time\n        +Float max_fuel\n        +Geography~LineString~ suggested_path\n        +Float estimated_time\n        +Float estimated_fuel\n        +Float risk_coverage\n        +DateTime created_at\n    }\n\n    class RiskHeatmap {\n        +UUID id\n        +String grid_resolution\n        +String time_interval\n        +DateTime computed_at\n    }\n\n    class GridCell {\n        +UUID id\n        +Geography~Polygon~ polygon_bounds\n        +Float risk_score\n    }\n\n    class ExplainabilityMetric {\n        +UUID id\n        +String key_reason\n        +Float confidence_level\n    }\n\n    %% Inheritance / Specialization\n    GeospatialEvent &lt;|-- Incident\n    GeospatialEvent &lt;|-- Sighting\n    GeospatialEvent &lt;|-- PatrolTrack\n\n    %% User &amp; Reporting Relationships\n    User \&quot;1\&quot; --&gt; \&quot;*\&quot; AuditLog : Views\n    User \&quot;1\&quot; --&gt; \&quot;*\&quot; FieldReport : Captures\n    User \&quot;1\&quot; --&gt; \&quot;*\&quot; TipOff : Submits\n    User --&gt; UploadWizard : Uploads\n    UploadWizard --&gt; GeospatialEvent : Creates\n\n    FieldReport \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Incident : Creates\n    FieldReport \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Sighting : Creates\n\n    %% Spatial &amp; Analytics Relationships\n    GeospatialEvent \&quot;1\&quot; --&gt; \&quot;*\&quot; Photo : Includes\n    RiskEngine --&gt; GeospatialEvent : Processes\n    RiskEngine --&gt; RiskHeatmap : Produces\n\n    %% Patrol Planning Relationships\n    User \&quot;1\&quot; --&gt; \&quot;*\&quot; PatrolRoute : Requests\n    PatrolPlanner --&gt; PatrolRoute : Generates\n    PatrolPlanner --&gt; RiskHeatmap : Uses\n\n    %% Grid &amp; Explainability Relationships\n    RiskHeatmap \&quot;1\&quot; --&gt; \&quot;*\&quot; GridCell : Contains\n    GridCell \&quot;1\&quot; --&gt; \&quot;*\&quot; ExplainabilityMetric : Clarifies&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="G9a5MQ6FTD-wDdqk8wM4-1">
